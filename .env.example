# Copy to .env and fill in. docker-compose reads this file automatically.
#
# ONLY secrets and infrastructure belong here. Every strategy/risk tunable —
# including all of the order-book scalper's settings (SCALP_*) — is a DYNAMIC
# setting: defaults live in app/config.py's _DEFAULTS, overrides are edited live
# at /settings and persisted in the app_settings table. Putting one here would
# have no effect (config.py does not read env for them).

# ── Gemini (pre-market grounded screen) ──
GEMINI_API_KEY=your-gemini-api-key

# ── PostgreSQL on the host machine ──
# host.docker.internal points at the host from inside the container (Linux uses
# the host-gateway mapping in docker-compose.yml). Adjust user/password/db/port.
POSTGRES_DSN=postgresql://postgres:your-password@host.docker.internal:5432/trading_db
