# Copy to .env and fill in. docker-compose reads this file automatically.

# ── PostgreSQL on the host machine ──
# host.docker.internal points at the host from inside the container (Linux uses
# the host-gateway mapping in docker-compose.yml). Adjust user/password/db/port.
POSTGRES_DSN=postgresql://postgres:ab45cd12@host.docker.internal:5432/mano_trading_db
POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/mano_trading_db

# ── Settings-page login (see app/auth.py) ──
# Gates only /settings and /api/settings*, nothing else. Required - the app
# fails closed (500) on any Settings request if SETTINGS_PASSWORD is unset.
SETTINGS_USER=admin
SETTINGS_PASSWORD=

# Contact address certbot registers the Let's Encrypt account under (see ssl.sh)
CERTBOT_EMAIL=
