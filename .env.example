# Copy to .env and fill in. docker-compose reads this file automatically.

# ── PostgreSQL on the host machine ──
# host.docker.internal points at the host from inside the container (Linux uses
# the host-gateway mapping in docker-compose.yml). Adjust user/password/db/port.
# (Found in review, 2026-09-23: this used to be defined TWICE with different
# hosts/credentials — python-dotenv's last-value-wins meant the second line
# silently overrode the first. Use the host.docker.internal form for the
# documented `docker compose up` flow; swap to localhost only if running
# `python main.py` locally against a Postgres on the same machine outside Docker.)
POSTGRES_DSN=postgresql://postgres:ab45cd12@host.docker.internal:5432/mano_trading_db

# ── Whole-app login (see app/auth.py) ──
# Gates every page/API route except /ws/dashboard and /login. Required - the
# app fails closed (500) on any gated request if either is unset.
SETTINGS_USER=admin
SETTINGS_PASSWORD=
# Random signing key for the login session cookie - NOT a password, generate
# with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# Contact address certbot registers the Let's Encrypt account under (see ssl.sh)
CERTBOT_EMAIL=
