<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane
    prefWidth="1600" prefHeight="940"
    styleClass="root-pane"
    stylesheets="@hellofx.css"
    fx:controller="org.example.hellofx.MainController"
    xmlns="http://javafx.com/javafx"
    xmlns:fx="http://javafx.com/fxml/1">

  <!-- ═══════════════════════ HEADER ═══════════════════════ -->
  <top>
    <HBox styleClass="header" alignment="CENTER_LEFT" spacing="12">
      <padding><Insets top="8" right="16" bottom="8" left="16"/></padding>

      <!-- Brand -->
      <VBox spacing="1" alignment="CENTER_LEFT">
        <Label text="BankNifty" styleClass="brand-title"/>
        <Label text="LIVE TRADING TERMINAL" styleClass="brand-sub"/>
      </VBox>

      <Separator orientation="VERTICAL" styleClass="header-sep"/>

      <!-- Controls row -->
      <HBox spacing="8" alignment="CENTER_LEFT" styleClass="control-group">
        <Label text="Interval" styleClass="ctrl-label"/>
        <ComboBox fx:id="comboInterval" prefWidth="72" styleClass="ctrl-combo"/>
        <Label text="Candles" styleClass="ctrl-label"/>
        <Spinner fx:id="spinnerNumCandles" prefWidth="58" styleClass="ctrl-spinner"/>
        <Label text="Offset" styleClass="ctrl-label"/>
        <Spinner fx:id="spinnerCandleOffset" prefWidth="68" styleClass="ctrl-spinner"/>
      </HBox>

      <Separator orientation="VERTICAL" styleClass="header-sep"/>

      <!-- Signal pill -->
      <HBox styleClass="signal-pill" spacing="6" alignment="CENTER">
        <Label text="SIGNAL" styleClass="pill-key"/>
        <Label fx:id="labelGlobalSignal" text="NEUTRAL" styleClass="pill-value"/>
      </HBox>

      <!-- Breakout label -->
      <Label fx:id="labelBreakout" text="—" styleClass="breakout-tag" wrapText="true" maxWidth="220"/>

      <Pane HBox.hgrow="ALWAYS"/>

      <!-- Connection badges -->
      <HBox spacing="6" alignment="CENTER">
        <HBox styleClass="badge-box" spacing="4" alignment="CENTER">
          <Label text="API" styleClass="badge-key"/>
          <Label fx:id="labelApiStatus" text="—" styleClass="badge-val"/>
        </HBox>
        <HBox styleClass="badge-box" spacing="4" alignment="CENTER">
          <Label text="WS" styleClass="badge-key"/>
          <Label fx:id="labelWsStatus" text="—" styleClass="badge-val"/>
        </HBox>
      </HBox>

      <Separator orientation="VERTICAL" styleClass="header-sep"/>

      <!-- Funds -->
      <HBox styleClass="funds-chip" spacing="5" alignment="CENTER">
        <Label text="FUNDS" styleClass="chip-key"/>
        <Label fx:id="labelFunds" text="₹—" styleClass="chip-value"/>
      </HBox>

      <Separator orientation="VERTICAL" styleClass="header-sep"/>

      <!-- Clock -->
      <VBox spacing="2" alignment="CENTER">
        <Canvas fx:id="clockCanvas" width="72" height="72"/>
        <Label fx:id="labelTime" text="--:--:-- IST" styleClass="clock-digital"/>
      </VBox>
    </HBox>
  </top>

  <!-- ═══════════════════════ BODY ═══════════════════════ -->
  <center>
    <SplitPane dividerPositions="0.63" styleClass="main-split">

      <!-- ──────────── LEFT PANEL ──────────── -->
      <VBox spacing="8" styleClass="col-left">
        <padding><Insets top="10" right="6" bottom="10" left="10"/></padding>

        <!-- Active position bar -->
        <HBox styleClass="position-bar" spacing="10" alignment="CENTER_LEFT">
          <padding><Insets top="6" right="12" bottom="6" left="12"/></padding>
          <Label text="▸ POSITION" styleClass="pos-key"/>
          <Label fx:id="labelActiveTrade" text="No active trade" styleClass="pos-value"/>
          <Pane HBox.hgrow="ALWAYS"/>
          <Button fx:id="btnExit" text="EXIT NOW" onAction="#onExit"
                  styleClass="btn-exit" disable="true"/>
        </HBox>

        <!-- Candle table card -->
        <VBox styleClass="card" VBox.vgrow="ALWAYS">
          <HBox styleClass="card-header" alignment="CENTER_LEFT" spacing="8">
            <Label text="▸ STOCK CANDLES" styleClass="card-title"/>
          </HBox>
          <TableView fx:id="tableStocks" VBox.vgrow="ALWAYS" styleClass="data-table"/>
        </VBox>

        <!-- Bottom two cards side by side -->
        <HBox spacing="8" prefHeight="220">
          <!-- Big trades card -->
          <VBox styleClass="card" HBox.hgrow="ALWAYS">
            <HBox styleClass="card-header" alignment="CENTER_LEFT">
              <Label text="▸ BIG TRADES (QTY)" styleClass="card-title"/>
            </HBox>
            <TableView fx:id="tableBigTrades" VBox.vgrow="ALWAYS" styleClass="data-table"/>
          </VBox>

          <!-- Trade dashboard card -->
          <VBox styleClass="card" HBox.hgrow="ALWAYS">
            <HBox styleClass="card-header" alignment="CENTER_LEFT" spacing="8">
              <Label text="▸ TRADE DASHBOARD" styleClass="card-title"/>
              <Pane HBox.hgrow="ALWAYS"/>
              <RadioButton fx:id="radioToday" text="Today" selected="true"
                           onAction="#onFilterToday" styleClass="tog-btn"/>
              <RadioButton fx:id="radioAll" text="All"
                           onAction="#onFilterAll" styleClass="tog-btn"/>
              <Button text="✕" onAction="#onClearTrades" styleClass="btn-icon-danger"/>
            </HBox>
            <TableView fx:id="tableTrades" VBox.vgrow="ALWAYS" styleClass="data-table"/>
            <Label fx:id="labelTradeSummary" text="" styleClass="summary-bar" wrapText="true">
              <padding><Insets top="4" right="8" bottom="4" left="8"/></padding>
            </Label>
          </VBox>
        </HBox>

      </VBox>

      <!-- ──────────── RIGHT PANEL ──────────── -->
      <ScrollPane fitToWidth="true" styleClass="right-scroll">
        <VBox spacing="8" styleClass="col-right">
          <padding><Insets top="10" right="10" bottom="10" left="6"/></padding>

          <!-- Order Entry card -->
          <VBox styleClass="card">
            <HBox styleClass="card-header" alignment="CENTER_LEFT">
              <Label text="▸ ORDER ENTRY" styleClass="card-title"/>
            </HBox>
            <VBox spacing="10">
              <padding><Insets top="10" right="12" bottom="10" left="12"/></padding>
              <HBox spacing="10" alignment="CENTER">
                <Label text="Type" styleClass="form-label"/>
                <ComboBox fx:id="comboOrderType" prefWidth="100" styleClass="ctrl-combo"/>
                <Label text="Price" styleClass="form-label"/>
                <TextField fx:id="fieldOrderPrice" promptText="Live price" prefWidth="110"
                           styleClass="price-field"/>
              </HBox>
              <HBox spacing="12" alignment="CENTER">
                <Button fx:id="btnBuy"  text="▲  BUY"  onAction="#onBuy"
                        styleClass="btn-buy"  prefWidth="130" prefHeight="36"/>
                <Button fx:id="btnSell" text="▼  SELL" onAction="#onSell"
                        styleClass="btn-sell" prefWidth="130" prefHeight="36"/>
              </HBox>
            </VBox>
          </VBox>

          <!-- Entry Loop Monitor card -->
          <VBox styleClass="card">
            <HBox styleClass="card-header" alignment="CENTER_LEFT">
              <Label text="▸ ENTRY LOOP MONITOR" styleClass="card-title"/>
            </HBox>
            <ScrollPane fitToWidth="true" prefHeight="340" styleClass="inner-scroll">
              <VBox fx:id="panelEntryLoop" spacing="4">
                <padding><Insets top="8" right="10" bottom="8" left="10"/></padding>
                <Label text="Waiting for data…" styleClass="muted"/>
              </VBox>
            </ScrollPane>
          </VBox>

          <!-- ATM Option card -->
          <VBox styleClass="card">
            <HBox styleClass="card-header" alignment="CENTER_LEFT">
              <Label text="▸ ATM OPTION  (Black-Scholes)" styleClass="card-title"/>
            </HBox>
            <VBox fx:id="panelAtmOption" spacing="6">
              <padding><Insets top="8" right="10" bottom="8" left="10"/></padding>
              <Label text="No active position" styleClass="muted"/>
            </VBox>
          </VBox>

          <!-- Support &amp; Resistance card -->
          <VBox styleClass="card">
            <HBox styleClass="card-header" alignment="CENTER_LEFT" spacing="8">
              <Label text="▸ SUPPORT &amp; RESISTANCE" styleClass="card-title"/>
              <Pane HBox.hgrow="ALWAYS"/>
              <Button text="↺ Refresh" onAction="#onRefreshSR" styleClass="btn-small"/>
            </HBox>
            <VBox fx:id="panelSRZone" spacing="4">
              <padding><Insets top="8" right="10" bottom="8" left="10"/></padding>
              <Label text="Loading…" styleClass="muted"/>
            </VBox>
          </VBox>

          <!-- Alert card -->
          <VBox styleClass="card-alert">
            <HBox styleClass="card-header" alignment="CENTER_LEFT">
              <Label text="▸ ALERTS" styleClass="card-title"/>
            </HBox>
            <Label fx:id="labelPoints" text="—" styleClass="alert-text" wrapText="true">
              <padding><Insets top="6" right="10" bottom="6" left="10"/></padding>
            </Label>
          </VBox>

        </VBox>
      </ScrollPane>

    </SplitPane>
  </center>

</BorderPane>
